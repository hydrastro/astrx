# Copy to .env and fill in. docker-compose and the app (getenv) read these.

# REQUIRED: MariaDB root password HASH (no default ships — docker-compose fails
# fast if unset). Generate from a running MariaDB:  SELECT PASSWORD('your-strong-pw');
# It looks like  *ABCDEF... (41 chars). Use a unique strong value per deployment.
MARIADB_ROOT_PASSWORD_HASH=

APP_ENV=development

DB_HOST=mariadb
DB_PORT=3306
# Name of the application database docker-compose creates on first boot
# (fed to the MariaDB entrypoint as MARIADB_DATABASE). This MUST match the
# database the app actually uses: resources/config/PDO.config.php (db_name) and
# the schema in src/setup/tables.sql (which starts with `USE content_manager;`)
# both use 'content_manager', so keep it unless you also update those.
DB_NAME=content_manager
DB_USER=user
# REQUIRED: application DB password. NO default ships. docker-compose feeds this
# to the MariaDB entrypoint (MARIADB_PASSWORD) and FAILS FAST if it is empty, so
# you must set a strong, unique value here (never reuse the root password).
# NB: the running app authenticates via resources/config/PDO.config.php
# (db_password), NOT this env var — set the SAME value there (through
# public/setup.php, tools/install.php, or by editing that file). Do not commit .env.
DB_PASSWORD=

MAIL_HOST=localhost
MAIL_PORT=25
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=App
MAIL_ENCRYPTION=
MAIL_DOMAIN=localhost
MAIL_LOCAL=false

IMAP_HOST=localhost
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VERIFY_SSL=false
# Trust a bare "* PREAUTH" IMAP greeting as authenticated (skips LOGIN). Keep
# false unless the IMAP server is trusted/local.
IMAP_ALLOW_PREAUTH=false
