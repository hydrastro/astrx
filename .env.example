# Copy to .env and fill in. docker-compose and the app (getenv) read these.

# REQUIRED: MariaDB root password HASH (no default ships — docker-compose fails
# fast if unset). Generate from a running MariaDB:  SELECT PASSWORD('your-strong-pw');
# It looks like  *ABCDEF... (41 chars). Use a unique strong value per deployment.
MARIADB_ROOT_PASSWORD_HASH=

APP_ENV=development

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=astrx
DB_USER=user
DB_PASSWORD=password

MAIL_HOST=localhost
MAIL_PORT=25
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=App
MAIL_ENCRYPTION=
MAIL_DOMAIN=localhost
MAIL_LOCAL=false

IMAP_HOST=localhost
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VERIFY_SSL=false
# Trust a bare "* PREAUTH" IMAP greeting as authenticated (skips LOGIN). Keep
# false unless the IMAP server is trusted/local.
IMAP_ALLOW_PREAUTH=false
