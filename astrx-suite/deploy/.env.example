# astrx-suite deployment settings.
#
# Copy this to the SUITE ROOT as `.env` (next to docker-compose.yml):
#     cp deploy/.env.example .env
# docker compose reads `.env` automatically from the compose-file directory.

# Project name — prefixes container / volume / network names.
COMPOSE_PROJECT_NAME=astrx-suite

# Tag applied to every built image (astrx/<tool>:${IMAGE_TAG}).
IMAGE_TAG=latest

# Optional services are gated behind Compose profiles. Leave EMPTY for the
# always-on, published stack. Enable extras by listing profiles (comma-sep):
#   crawl  -> onioncrawler-crawl + websearch-crawl (one-off batch crawlers)
#   index  -> torrentds-index    (long-running clearnet DHT harvester)
# Example: COMPOSE_PROFILES=crawl,index
COMPOSE_PROFILES=

# Timezone for the tor container's log timestamps.
TZ=UTC

# --- Reference only (do not change without editing deploy/torrc) -----------
# Tor SOCKS port offered to onioncrawler-crawl on the INTERNAL network only;
# it is never published to the host.
# TOR_SOCKS_PORT=9050
