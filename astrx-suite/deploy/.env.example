# astrx-suite — deployment settings. Copy to the SUITE ROOT as `.env`:
#     cp deploy/.env.example .env
#
# Every value here is optional; the defaults run the published stack behind Tor.

# Image tag applied to every built image (astrx/websearch:${IMAGE_TAG}, ...).
IMAGE_TAG=latest

# Optional compose profiles. The published, always-on services need no profile.
# Add the crawlers/indexers you want running:
#   crawl-web    the clearnet crawler (needs egress)
#   crawl-onion  the darknet crawler (egress via Tor SOCKS only)
#   index-dht    the torrentds DHT harvester (needs egress)
#   tracker      the BitTorrent trackers
# e.g.  COMPOSE_PROFILES=crawl-onion,tracker
COMPOSE_PROFILES=

# gitweb: optional HTTP Basic credential (user:hash). Generate the hash with
#     docker compose run --rm gitweb --hash-password
# Leave empty to serve the repositories read-only and unauthenticated.
GITWEB_AUTH=
