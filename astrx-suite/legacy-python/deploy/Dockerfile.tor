# Tor ingress for the astrx-suite.
#
# Reuses the SAME python:3.11-slim base the app images use (it is Debian
# bookworm underneath), so a whole deployment only ever pulls one base image.
# The Debian `tor` package brings the daemon and creates the `debian-tor` user.
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tor \
    && rm -rf /var/lib/apt/lists/*

# Hidden-service keys and Tor state live here; the compose `tor-keys` volume
# mounts over it to keep the .onion addresses stable across restarts.
VOLUME ["/var/lib/tor"]

COPY torrc /etc/tor/torrc
COPY tor-entrypoint.sh /usr/local/bin/tor-entrypoint.sh
RUN chmod +x /usr/local/bin/tor-entrypoint.sh

# SOCKS for the crawler on the internal Docker network (never host-published).
EXPOSE 9050

# The entrypoint runs as root, fixes the key-volume ownership, then execs Tor,
# which setuids to debian-tor (torrc `User`).  Extra args (e.g. --verify-config)
# are passed straight through to tor.
ENTRYPOINT ["/usr/local/bin/tor-entrypoint.sh"]
