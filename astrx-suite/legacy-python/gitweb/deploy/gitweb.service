# systemd unit for gitweb.
#
# Install:   cp deploy/gitweb.service /etc/systemd/system/
#            systemctl daemon-reload && systemctl enable --now gitweb
#
# Serves the repositories under /srv/git on loopback only; front it with a Tor
# onion service or reverse proxy.  Adjust --root / --port to taste.
[Unit]
Description=gitweb read-only, no-JavaScript git web viewer
After=network.target
Documentation=https://example.invalid/gitweb

[Service]
Type=simple
ExecStart=/usr/bin/env gitweb --root /srv/git --host 127.0.0.1 --port 8801 --quiet
Restart=on-failure
RestartSec=2

# Least-privilege hardening: an ephemeral unprivileged user, a read-only view
# of the host, no home, private /tmp and /dev, and only the repo root readable.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/srv/git

[Install]
WantedBy=multi-user.target
