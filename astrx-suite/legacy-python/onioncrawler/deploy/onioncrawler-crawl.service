# systemd unit for the onioncrawler crawler (resumable; restarts continue where
# they left off). Install to /etc/systemd/system/ and `systemctl enable --now`.
#
#   useradd --system --home /var/lib/onioncrawler onioncrawler
#   install -d -o onioncrawler /var/lib/onioncrawler
#   # populate /var/lib/onioncrawler/seeds.txt + the abuse blocklists first!

[Unit]
Description=onioncrawler Tor hidden-service crawler
Documentation=file:/usr/share/doc/onioncrawler/README.md
After=network-online.target tor.service
Wants=network-online.target
Requires=tor.service

[Service]
Type=simple
User=onioncrawler
Group=onioncrawler
WorkingDirectory=/var/lib/onioncrawler
ExecStart=/usr/local/bin/onioncrawler crawl \
    --db /var/lib/onioncrawler/crawl.db \
    --seeds /var/lib/onioncrawler/seeds.txt \
    --tor-host 127.0.0.1 --tor-port 9050 \
    --blocklist-hosts /var/lib/onioncrawler/blocklist_hosts.txt \
    --blocklist-keywords /var/lib/onioncrawler/blocklist_keywords.txt \
    -v
Restart=on-failure
RestartSec=15
# graceful stop: the crawler catches SIGTERM, finishes in-flight work, and
# returns leases to the queue so a restart resumes cleanly.
KillSignal=SIGTERM
TimeoutStopSec=30

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/onioncrawler

[Install]
WantedBy=multi-user.target
