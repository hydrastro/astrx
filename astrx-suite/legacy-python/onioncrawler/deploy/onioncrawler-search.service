# systemd unit for the onioncrawler no-JS search server. Bind to 127.0.0.1 and
# publish it as a v3 hidden service via torrc (see torrc.example). Set
# ONIONCRAWLER_ADMIN_* if you want the /add /purge /recrawl admin actions.

[Unit]
Description=onioncrawler no-JS search server
Documentation=file:/usr/share/doc/onioncrawler/README.md
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=onioncrawler
Group=onioncrawler
WorkingDirectory=/var/lib/onioncrawler
Environment=ONIONCRAWLER_DB=/var/lib/onioncrawler/crawl.db
ExecStart=/usr/local/bin/onioncrawler search \
    --db /var/lib/onioncrawler/crawl.db \
    --host 127.0.0.1 --port 8802 \
    --blocklist-hosts /var/lib/onioncrawler/blocklist_hosts.txt \
    --blocklist-keywords /var/lib/onioncrawler/blocklist_keywords.txt
Restart=on-failure
RestartSec=10

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/onioncrawler

[Install]
WantedBy=multi-user.target
