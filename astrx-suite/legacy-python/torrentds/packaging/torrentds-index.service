[Unit]
Description=torrentds DHT metadata harvester
Documentation=https://example.invalid/torrentds
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=torrentds
ExecStart=/usr/bin/torrentds index --db /var/lib/torrentds/torrentds.db --host 0.0.0.0 --port 6881
Restart=on-failure
RestartSec=5
# Hardening: the harvester needs no privileges beyond its network socket.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
