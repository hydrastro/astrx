{
    "name": "astrx/module-content",
    "description": "Markdown pages with wiki links, backlinks, a page graph and a broken-link checker",
    "type": "astrx-module",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "astrx-module"
    ],
    "homepage": "https://github.com/hydrastro/module-content",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "astrx/cms": "self.version",
        "astrx/framework": "self.version",
        "astrx/library": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\Content\\": ""
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/cms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/framework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/library"
        }
    ]
}
