{
    "name": "astrx/module-imageboard",
    "description": "Imageboard: boards, threads, image posts, moderation and feeds",
    "type": "astrx-module",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "astrx-module"
    ],
    "homepage": "https://github.com/hydrastro/module-imageboard",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "astrx/cms": "self.version",
        "astrx/framework": "self.version",
        "astrx/library": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\Imageboard\\": ""
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/cms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/framework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hydrastro/library"
        }
    ]
}
