parameters:
    level: 10
    paths:
        - src
        - packages
        - public
        - tools
        - examples
    treatPhpDocTypesAsCertain: false
    excludePaths:
        analyseAndScan:
            - build/*
            - resources/template/cache/*
            - packages/modules/*/resources/*
            - public/compiled.php
            - public/compile/index.php
            - public/setup.php
            - tools/verify-compiled.php
