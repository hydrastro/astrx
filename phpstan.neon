parameters:
    level: 10
    paths:
        - src
        - public
        - tools
    treatPhpDocTypesAsCertain: false
    excludePaths:
        analyseAndScan:
            - build/*
            - resources/template/cache/*
            - public/compiled.php
            - public/compile/index.php
            - public/setup.php
            - tools/verify-compiled.php
